  "description": "Industry-level backend template with Express.js, TypeScript, MongoDB, and authentication",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
