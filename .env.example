# ==============================================
# BACKEND TEMPLATE ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and update the values

# ==============================================
# SERVER CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=5000

# ==============================================
# PROJECT CONFIGURATION
# ==============================================
PROJECT_NAME=backend-template
PROJECT_DISPLAY_NAME=Backend Template
PROJECT_DESCRIPTION=A modern, secure, and scalable Node.js backend template
PROJECT_VERSION=1.0.0

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/backend-template
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb://localhost:27017/backend-template

# ==============================================
# JWT CONFIGURATION
# ==============================================
# Use strong, unique secrets for production
# Generate secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here-change-this-in-production

# Token expiration times
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ==============================================
# CORS CONFIGURATION
# ==============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================
# CLOUDINARY CONFIGURATION (OPTIONAL)
# ==============================================
# Set to true to enable file upload features
ENABLE_CLOUDINARY=false

# Cloudinary credentials (get from https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==============================================
# EMAIL CONFIGURATION (OPTIONAL)
# ==============================================
# Email service configuration for password reset, verification, etc.
EMAIL_FROM=noreply@yourapp.com

# SMTP Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Alternative: SendGrid API Key
# SENDGRID_API_KEY=your-sendgrid-api-key

# Alternative: Mailgun Configuration
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain

# ==============================================
# REDIS CONFIGURATION (OPTIONAL)
# ==============================================
# Redis URL for caching and session storage
# For local Redis: redis://localhost:6379
# For Redis Cloud: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# ==============================================
# APPLICATION URLS
# ==============================================
# Frontend application URL (for CORS and redirects)
CLIENT_URL=http://localhost:3000

# Backend server URL (for email links, etc.)
SERVER_URL=http://localhost:5000

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Password reset token expiration (in minutes)
PASSWORD_RESET_EXPIRE=10

# Email verification token expiration (in hours)
EMAIL_VERIFICATION_EXPIRE=24

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Log file paths (relative to project root)
LOG_FILE=logs/app.log
ERROR_LOG_FILE=logs/error.log

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Upload directory for local file storage
UPLOAD_DIR=uploads

# ==============================================
# DATABASE SEEDING (OPTIONAL)
# ==============================================
# Set to true to seed the database with initial data
SEED_DATABASE=false

# Admin user credentials for seeding
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassword123!

# ==============================================
# THIRD-PARTY INTEGRATIONS (OPTIONAL)
# ==============================================

# Google OAuth (if implementing social login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (if implementing social login)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# AWS S3 Configuration (alternative to Cloudinary)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Stripe Configuration (for payments)
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ==============================================
# MONITORING AND ANALYTICS (OPTIONAL)
# ==============================================

# Sentry for error tracking
SENTRY_DSN=your-sentry-dsn

# Google Analytics
GA_TRACKING_ID=your-google-analytics-id

# New Relic for performance monitoring
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
NEW_RELIC_APP_NAME=backend-template

# ==============================================
# DEVELOPMENT CONFIGURATION
# ==============================================
# Set to true to enable debug mode
DEBUG=false

# Set to true to enable API request/response logging
LOG_REQUESTS=true

# Set to true to enable detailed error messages in development
DETAILED_ERRORS=true

# ==============================================
# PRODUCTION NOTES
# ==============================================
# For production deployment:
# 1. Change NODE_ENV to 'production'
# 2. Use strong, unique secrets for JWT_SECRET and JWT_REFRESH_SECRET
# 3. Use production database URLs
# 4. Set appropriate ALLOWED_ORIGINS
# 5. Configure proper email service
# 6. Set up monitoring and error tracking
# 7. Use environment-specific values for all URLs
# 8. Enable SSL/HTTPS in production
# 9. Set up proper backup strategies
# 10. Configure log rotation and monitoring